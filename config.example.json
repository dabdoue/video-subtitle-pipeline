{
  "anchor_seconds": 5.0,
  "minimum_anchor_seconds": 1.0,
  "audio_overlap": 1.0,
  "audio_stream": 0,
  "asr_provider": "openai-compatible",
  "asr_mode": "whole",
  "asr_url": "https://your-asr-host.example/v1/audio/transcriptions",
  "asr_model": "nvidia/nemotron-3.5-asr-streaming-0.6b",
  "asr_api_key_env": "ASR_API_KEY",
  "env_file": ".env",
  "asr_workers": 4,
  "allow_audio_upload": false,
  "stitch_provider": "codex",
  "stitch_model": "gpt-5.6-luna",
  "stitch_batch_size": 40,
  "translate_provider": "codex",
  "translation_model": "gpt-5.6-luna",
  "translation_batch_size": 40,
  "reasoning_effort": "low",
  "source_language": "English",
  "target_language": "Korean",
  "language_code": "ko-bilingual-5s",
  "max_parts": 1,
  "minimum_tail_text_chars": 3,
  "include_source": true,
  "burn": true,
  "font_size": 18,
  "max_line_chars": 52,
  "crf": 19,
  "preset": "fast"
}
