# Remote or local OpenAI-compatible audio transcription endpoint.
# Leave unset when using --asr-provider command.
ASR_URL=https://your-asr-host.example/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b

# Defaults for Codex CLI stitching and translation. Any Codex-accessible model
# may be supplied on the command line instead.
STITCH_MODEL=gpt-5.6-luna
TRANSLATION_MODEL=gpt-5.6-luna

